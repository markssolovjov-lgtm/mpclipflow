# ───────────── MP ClipFlow — конфигурация ─────────────
# Скопируйте в .env и заполните. Не коммитьте .env!

NODE_ENV=development
PORT=8080
# Публичный адрес приложения (используется в OAuth redirect и ссылках)
PUBLIC_URL=http://localhost:8080
# Адрес фронтенда в режиме разработки (Vite)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL. Docker: docker compose up -d postgres; без Docker: npm run db:local
DATABASE_URL=postgresql://clipflow:clipflow@localhost:5433/clipflow

# 32 байта в base64 для шифрования токенов TikTok (AES-256-GCM).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=THZkc/bNQLDXryIGeAOVzMw3aHlleWNth+AiSdrNJw0=

# ───── Хранилище ─────
# local — файлы на диске сервера; s3 — S3-совместимое хранилище (AWS S3, MinIO, Cloudflare R2, Yandex Object Storage)
STORAGE_DRIVER=local
DATA_DIR=./data
# Запас свободного места на диске, ниже которого новые загрузки/рендеры ставятся в ожидание (МБ).
# Это защита инфраструктуры, а не продуктовый лимит на размер видео.
MIN_FREE_DISK_MB=2048

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ───── Видеопроцессинг ─────
# Пути к ffmpeg/ffprobe. Пусто — используются бинарники из ffmpeg-static / ffprobe-static.
FFMPEG_PATH=
FFPROBE_PATH=
# Сколько рендеров выполнять одновременно на одном воркере
RENDER_CONCURRENCY=1
# Запускать фоновые обработчики внутри API-процесса (true) или отдельно через npm run start:worker (false)
RUN_WORKERS_IN_API=true

# ───── TikTok (Content Posting API) ─────
# Создайте приложение на https://developers.tiktok.com, добавьте продукты Login Kit и Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Должен совпадать с Redirect URI в настройках приложения TikTok
TIKTOK_REDIRECT_URI=http://localhost:8080/api/tiktok/callback
# Запрашиваемые разрешения. video.publish — прямая публикация, video.upload — отправка черновика во «Входящие».
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish
